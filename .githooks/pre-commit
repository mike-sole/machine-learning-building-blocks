#!/bin/sh
# Stops a commit that contains a secret (API key, token, private key...), before it's in the history.
# Needs gitleaks (https://github.com/gitleaks/gitleaks#installing); CI scans every push either way.
# Skip with `git commit --no-verify` only for a false positive, or mark the line with `gitleaks:allow`.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks isn't installed, so staged changes weren't scanned for secrets" >&2
    exit 0
fi
exec gitleaks git --staged --redact --no-banner .
